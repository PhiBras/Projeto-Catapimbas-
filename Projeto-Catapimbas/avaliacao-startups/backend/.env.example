PORT=3000
# Supabase: painel > Connect > "Session pooler" (cole a URL e troque [YOUR-PASSWORD] pela senha do banco)
DATABASE_URL=postgres://postgres.SEUPROJETO:SUASENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# Banco SEPARADO para os testes (o seed apaga tudo!). Pode ser um PostgreSQL local ou outro projeto Supabase.
DATABASE_URL_TESTE=postgresql://postgres:SUASENHA@localhost:5432/avaliacao_teste
# usados só pelo comando "npm run super"
SUPER_NOME=Superadministrador
SUPER_EMAIL=admin@suainstituicao.com.br
SUPER_SENHA=troque-por-uma-senha-forte
